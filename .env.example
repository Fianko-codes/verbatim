# AssemblyAI — https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=

# Database (libSQL). Local dev uses a SQLite file; production uses Turso.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Signing key for participant interview grants. REQUIRED in production —
# the app refuses to start without it. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public base URL (used for share links). Optional locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password for the seeded demo researcher account (username: demo).
# Only used by `pnpm db:seed`. Change it, or don't seed, outside a public demo.
DEMO_RESEARCHER_PASSWORD=verbatim-demo-2026
